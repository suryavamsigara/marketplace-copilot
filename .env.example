# ==============================================================================
# Marketplace Performance Copilot - Environment Configuration
# ==============================================================================

# Database Connection (Supabase PostgreSQL or fallback SQLite)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Pooler Format (Recommended for Render/Serverless): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# AI Reasoning Layer (OpenAI API)
# If left empty, Copilot gracefully falls back to deterministic analytics summaries.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# CORS allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://marketplace-copilot.vercel.app

# Frontend API URL (leave blank for local Vite proxy, or set to your deployed backend URL on Render)
VITE_API_URL=
